{
  "name": "comms-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "predev": "node scripts/preflight.mjs",
    "dev": "node server.mjs",
    "dev:3000": "cross-env PORT=3000 node server.mjs",
    "build": "prisma generate && next build",
    "start": "cross-env NODE_ENV=production node server.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev --name init",
    "db:deploy": "prisma migrate deploy",
    "db:post": "node scripts/apply-post-migrate.mjs",
    "db:setup": "npm run db:migrate && npm run db:post && npm run db:seed && npm run db:seed:channels",
    "db:seed": "tsx prisma/seed.ts",
    "benchmark": "tsx scripts/benchmark-argon2.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "npm run typecheck && npm run lint",
    "db:seed:channels": "tsx prisma/seed-channels.ts",
    "db:sync": "prisma db push",
    "db:cleanup-tests": "node scripts/cleanup-test-data.mjs",
    "worker": "node worker.mjs",
    "dev:all": "concurrently -n app,worker -c blue,magenta \"npm run dev\" \"npm run worker\"",
    "purge": "node scripts/purge.mjs",
    "purge:dry": "node scripts/purge.mjs --dry-run",
    "vapid": "node scripts/generate-vapid.mjs",
    "db:backfill-search": "node scripts/backfill-search.mjs",
    "setup:network": "node scripts/setup-network.mjs",
    "setup:tunnel": "node scripts/setup-tunnel.mjs",
    "db:backfill-general": "node scripts/backfill-general.mjs",
    "deploy:migrate": "node scripts/deploy-migrate.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "next": "15.5.23",
    "otplib": "^12.0.1",
    "qrcode": "1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "@socket.io/redis-adapter": "8.3.0",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "cookie": "1.0.2",
    "tsx": "4.19.2",
    "@aws-sdk/client-s3": "3.700.0",
    "@aws-sdk/s3-request-presigner": "3.700.0",
    "file-type": "19.6.0",
    "sharp": "0.33.5",
    "livekit-client": "2.7.2",
    "livekit-server-sdk": "2.9.2",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "pg": "^8.13.1",
    "postcss": "^8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "cross-env": "7.0.3",
    "concurrently": "9.1.0",
    "@types/web-push": "3.6.4"
  }
}