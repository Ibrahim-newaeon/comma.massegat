# .env.example — copy to .env and fill in.
#
# ⚠️  Save this file with LF line endings, not CRLF.
#     On Windows, edit in VS Code (bottom-right status bar shows LF/CRLF).
#     Values must be UNQUOTED with no trailing spaces.
#
# Generate the two secrets:
#   openssl rand -base64 48    -> JWT_SECRET            (any length >= 32 chars)
#   openssl rand -base64 32    -> TOTP_ENCRYPTION_KEY   (must decode to EXACTLY 32 bytes)
#
# On Windows without openssl, use Node instead:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development

DATABASE_URL=postgresql://comms:comms_dev_password@localhost:5432/comms
REDIS_URL=redis://localhost:6379
POSTGRES_PASSWORD=comms_dev_password

JWT_SECRET=CHANGE_ME_run_openssl_rand_base64_48
TOTP_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_base64_32

# ⚠️ MUST match the port the dev server actually binds to.
#    If port 3000 is taken, Next.js falls back to 3001 — update this line too,
#    or admin setup links will point at a dead port.
#    To force the port instead: npm run dev -- -p 3000
APP_URL=http://localhost:3000

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SETUP_TOKEN_TTL_SECONDS=86400

# ── Files (Phase 2) ──────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
# Where the SERVER reaches storage. Leave empty when they are the same host.
# Set it when S3_ENDPOINT is a public hostname behind a tunnel or CDN —
# otherwise the server routes its own reads out to the internet and back to
# reach a container beside it, and every upload fails verification.
S3_INTERNAL_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=comms-files
S3_ACCESS_KEY=comms_minio_user
S3_SECRET_KEY=comms_minio_password
S3_FORCE_PATH_STYLE=true

CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# ⚠️ Setting this false lets unscanned files reach users. Do not do that in
#    production. It exists so the suite can run without waiting ~5 minutes for
#    ClamAV to download its signature database on a cold start.
CLAMAV_ENABLED=true

MAX_FILE_BYTES=104857600
USER_QUOTA_BYTES=10737418240
CHANNEL_QUOTA_BYTES=53687091200

# ── Video (Phase 3) ──────────────────────────────────────────────────────
# Local dev uses LiveKit's --dev mode, which hardcodes this key/secret pair.
# ⚠️ These are PUBLIC well-known values. Generate real ones for production:
#      docker run --rm livekit/livekit-server generate-keys
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

MAX_CALL_PARTICIPANTS=10
CALL_TOKEN_TTL_SECONDS=21600

# ── Notifications (Phase 4) ──────────────────────────────────────────────
# Generate the pair:  npm run vapid
# Push is OPTIONAL — leave these empty and everything else works, notifications
# simply do not fire.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Retention (Phase 4) ──────────────────────────────────────────────────
# ⚠️ Confirm these with legal before production. 0 disables that sweep.
RETENTION_FILES_MONTHS=24
RETENTION_AUDIT_MONTHS=24
RETENTION_PURGE_DELETED_DAYS=30

# ── Self-registration (optional) ─────────────────────────────────────────
# EMPTY DISABLES SIGNUP — the safe default. An open form on a reachable URL is
# an open door, so enabling it must be a deliberate decision.
#   SIGNUP_ALLOWED_DOMAINS=new-aeon.com,al-ai.ai
SIGNUP_ALLOWED_DOMAINS=

# false: new accounts wait for an admin to approve them.
# true:  usable immediately — only sensible when Cloudflare Access (or
#        equivalent) already proves identity BEFORE the person reaches the form.
SIGNUP_AUTO_APPROVE=false

# Bootstrap admin — used once by the seed script. Password: 12+ chars.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-immediately-please
BOOTSTRAP_ADMIN_NAME=Administrator
